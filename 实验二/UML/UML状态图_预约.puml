@startuml

skinparam dpi 170
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontColor #213B4B
skinparam titleFontColor #163E4C
skinparam titleFontSize 22
skinparam shadowing false
skinparam ArrowColor #567083
skinparam ArrowThickness 1.3
skinparam nodesep 36
skinparam ranksep 38
skinparam noteBackgroundColor #F7F9FB
skinparam noteBorderColor #99ABB8
skinparam noteFontSize 13
skinparam legendBackgroundColor #F7F9FB
skinparam legendBorderColor #99ABB8

hide empty description
skinparam stateBackgroundColor #EFF5F8
skinparam stateBorderColor #507084
skinparam stateFontSize 17
skinparam stateArrowFontSize 14

title 预约状态图 · 与商品在事务 T 中联动

state "有效预约 A(p) · 商品必须已预约" as Active {
  state "待卖家确认" as Pending #FFF1D9
  state "卖家已确认" as Confirmed #E8F4EF
  [*] --> Pending
  Pending -right[#26725E]-> Confirmed : acceptReservation(...)\n[商品卖家；now < 截止]\n/ r.accept(now)
}
state "已拒绝" as Rejected
state "已过期" as Expired
state "已完成" as Completed #E8F4EF
state "已取消" as Cancelled

[*] --> Active : createReservation(...)\n/ 固定买家、商品、原价与约定
Pending --> Rejected : rejectReservation(...)\n[商品卖家；有原因]\n/ r.reject；商品已发布
Pending --> Expired : expireReservation(...)\n[now >= 截止]\n/ r.expire；商品已发布
Pending --> Cancelled : cancelReservation(...)\n[本单买家]\n/ r.cancel；商品已发布
Confirmed --> Cancelled : cancelReservation(...)\n[本单买家或卖家；有原因]\n/ r.cancel；商品已发布
Confirmed -[#26725E]-> Completed : completeReservation(...)\n[本单买家]\n/ r.complete；商品已售出
Active -[#AE4F62]-> Cancelled : ban(reason, now)\n[管理员；有原因]\n/ r.cancelByPlatform；商品已封禁

Rejected -right[hidden]-> Expired
Expired -right[hidden]-> Completed
Completed -right[hidden]-> Cancelled

legend bottom
  每条实际变更均要求 r 属于该商品且 r = /activeReservation；终态不再转回有效。
  /confirmDeadline = min(createdAt + 24h, terms.deliveryTime)，取锁后服务器时间。
  接受与新建遇到到期记录：先独立提交 X0 过期事务，再重试原操作的检查。
  普通释放保留 publishedAt；平台封禁不执行普通释放；已确认预约不自动过期。
endlegend

@enduml
