@startuml

skinparam dpi 170
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontColor #213B4B
skinparam titleFontColor #163E4C
skinparam titleFontSize 22
skinparam shadowing false
skinparam ArrowColor #567083
skinparam ArrowThickness 1.3
skinparam nodesep 36
skinparam ranksep 38
skinparam noteBackgroundColor #F7F9FB
skinparam noteBorderColor #99ABB8
skinparam noteFontSize 13
skinparam legendBackgroundColor #F7F9FB
skinparam legendBorderColor #99ABB8

!pragma layout smetana
hide circle
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #EFF5F8
skinparam classBorderColor #507084
skinparam classFontSize 17
skinparam classAttributeFontSize 14
skinparam classArrowFontSize 13

title 应用协作与记录 · 与核心领域分开

class "商品交易服务\nProductWorkflow" as Workflow <<application>> #E8F4EF {
  +execute(command, actor) : Result
  +expireIfDue(productID, reservationID) : Result
  --
  认证授权 → 提交键锁 → 原结果判断
  商品行锁 → 当前校验 → 领域动作
  同事务保存 → 提交后返回
}

class "商品\nProduct" as Product <<domain>> {
  核心状态与业务守卫
  商品、预约和审核提交的联动
}

class "操作结果\nOperationResult" as Result <<record>> {
  actorRef : ActorRef
  action : Action
  submissionKey : String
  requestDigest : String
  targetRef : ObjectRef
  outcome : SUCCESS | REJECTED
  resultCode : String
  resultRef : ObjectRef [0..1]
  committedState : ResultSnapshot
  savedAt : Instant
}

class "审计记录\nAuditEntry" as Audit <<record>> {
  logID : ID
  actorRef : ActorRef
  targetRef : ObjectRef
  action : Action
  kind : CHANGE | ACCESS | FAILURE
  outcome : SUCCESS | FAILURE
  occurredAt : Instant
  beforeState : StatePair [0..1]
  afterState : StatePair [0..1]
  reason : String [0..1]
}

Workflow .right.> Product : 调用；不绕过状态入口
Workflow .down.> Result : 保存最终结果 / 重试读取
Workflow .down.> Audit : 保存成功变更 / 失败说明
Result -[hidden]right- Audit

note bottom of Result
  K = (actorRef, action, submissionKey) 唯一
  无 PROCESSING 记录；处理权由事务锁表示。
  SUCCESS 与业务、成功审计在同一事务提交。
  REJECTED 仅表示已确定的业务拒绝。
end note

note bottom of Audit
  属于需求规定的支撑记录，不决定业务状态。
  重试不新增成功变更记录；访问另记 ACCESS。
  失败审计不能写成业务已成功。
end note

@enduml
